# SafeRoute AWS deploy configuration (non-secret).
# Copy values into your shell or GitHub Environment variables.
# Do NOT put Mapbox or AWS long-lived credentials in this file.

AWS_REGION=ap-southeast-2
AWS_PROFILE=saferoute-admin

ECR_REPOSITORY=saferoute
ECS_EXPRESS_SERVICE_NAME=saferoute-web
ECS_CLUSTER=default
CONTAINER_PORT=3000
HEALTH_CHECK_PATH=/api/health

# Express Mode task size (Fargate units; defaults match Express Mode docs)
ECS_CPU=256
ECS_MEMORY=512
ECS_MIN_TASKS=1
ECS_MAX_TASKS=2

# Named IAM roles / secret (names only — no secret values)
ECS_TASK_EXECUTION_ROLE_NAME=SafeRouteEcsTaskExecutionRole
ECS_INFRASTRUCTURE_ROLE_NAME=SafeRouteEcsInfrastructureRole
GITHUB_DEPLOY_ROLE_NAME=SafeRouteGitHubDeployRole
MAPBOX_SECRET_NAME=saferoute/mapbox-server
LOG_GROUP_NAME=/ecs/saferoute-web
LOG_RETENTION_DAYS=7
BUDGET_NAME=SafeRoute-Monthly-Budget

# GitHub
GITHUB_REPO=Madhav071204/SafeRoute-Security-Shuttle-Route-Optimisation-System
GITHUB_ENVIRONMENT=production
RELEASE_BRANCH=chore/release-baseline
