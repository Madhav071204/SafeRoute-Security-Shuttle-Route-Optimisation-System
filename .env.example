# SafeRoute Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# Mapbox API Token (required)
# Get your token at: https://account.mapbox.com/access-tokens/
# The public token is used for map display in the browser
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_public_token_here

# Mapbox Secret Token (optional, for server-side API calls)
# Only needed if you want to use server-side geocoding with higher rate limits
# MAPBOX_SECRET_TOKEN=your_mapbox_secret_token_here
