# ==============================================================================
# SafeRoute Environment Variables
# ==============================================================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control
#
# For deployment platforms (Vercel, Netlify, etc.), add these as environment
# variables in your platform's dashboard.
# ==============================================================================

# ==============================================================================
# MAPBOX CONFIGURATION (Required)
# ==============================================================================
# Get your tokens at: https://account.mapbox.com/access-tokens/
#
# Public token (REQUIRED): Used for client-side map display and search
# This token is exposed to the browser - use a public token with appropriate scopes
# Required scopes: styles:read, fonts:read, datasets:read, vision:read
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_public_token_here

# Secret token (OPTIONAL): For server-side API calls with higher rate limits
# Use this for production deployments with high traffic
# Keep this token secret and never expose it to the client
# MAPBOX_SECRET_TOKEN=your_mapbox_secret_token_here

# ==============================================================================
# APPLICATION SETTINGS (Optional)
# ==============================================================================
# Default origin for route optimization when GPS is unavailable
# Default: Monash University, Clayton (-37.9105, 145.1363)
# NEXT_PUBLIC_DEFAULT_ORIGIN_LAT=-37.9105
# NEXT_PUBLIC_DEFAULT_ORIGIN_LNG=145.1363
# NEXT_PUBLIC_DEFAULT_ORIGIN_LABEL=Monash University

# Search bias country (ISO 3166-1 alpha-2 code)
# Default: AU (Australia)
# NEXT_PUBLIC_SEARCH_COUNTRY=AU
