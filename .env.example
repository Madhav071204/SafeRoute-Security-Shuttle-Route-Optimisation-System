# ==============================================================================
# SafeRoute Environment Variables (placeholders only — never commit real values)
# ==============================================================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# NEVER commit .env.local. Docker images must not embed .env.local either —
# pass runtime values via Compose env_file / -e / platform secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# Mapbox — public (browser) token
# ------------------------------------------------------------------------------
# Used by Mapbox GL in the browser for map tiles / styles.
# Prefix NEXT_PUBLIC_ means Next.js embeds this value into the client bundle at
# BUILD time. Treat it as public: restrict URL/origins and scopes in the Mapbox
# dashboard (styles:read, fonts:read as needed for GL).
#
# Required for interactive maps in development and production builds that ship
# a real map. CI and Playwright do not need a real token (APIs are mocked).
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_public_token_here

# ------------------------------------------------------------------------------
# Mapbox — server-only token (recommended for API routes)
# ------------------------------------------------------------------------------
# Used by server routes for geocoding, routing and directions
# (/api/geocode-batch, /api/route, /api/directions). Never prefixed with
# NEXT_PUBLIC_, so it is not bundled into the browser.
#
# Prefer a least-privilege token scoped to the Mapbox APIs the server calls.
# In local development, if this is unset, server routes fall back to
# NEXT_PUBLIC_MAPBOX_TOKEN. Production should set MAPBOX_ACCESS_TOKEN explicitly.
MAPBOX_ACCESS_TOKEN=your_mapbox_server_token_here

# ------------------------------------------------------------------------------
# Docker / TLS (optional, advanced)
# ------------------------------------------------------------------------------
# If a corporate or university TLS interception proxy breaks certificate
# verification, point Node at an approved CA bundle — do NOT disable TLS:
#   NODE_EXTRA_CA_CERTS=/absolute/path/to/approved-ca.pem
#
# Do not set NODE_TLS_REJECT_UNAUTHORIZED=0.
# Do not set npm strict-ssl=false.
# Compose no longer provides an insecure TLS build default.

# ------------------------------------------------------------------------------
# Application / test tooling (optional)
# ------------------------------------------------------------------------------
# PLAYWRIGHT_PORT=3123
# PLAYWRIGHT_CHANNEL=chrome
# NEXT_DISABLE_STANDALONE=1
