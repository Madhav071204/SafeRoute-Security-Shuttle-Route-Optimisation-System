# Dependencies — installed fresh inside the image
node_modules

# Next.js build output — produced inside the image
.next
out
build

# Git metadata — not needed to run the app
.git
.gitignore

# Environment files — secrets must be injected at build/run time, not baked in
.env
.env.*
!.env.example

# Local tooling and editor files
.idea
.vscode
*.swp
*.swo
Thumbs.db
.DS_Store

# Logs and debug artefacts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Test and coverage output — never ship in the image
coverage
test-results
playwright-report
blob-report
e2e
tests
vitest.config.ts
playwright.config.ts
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx

# TypeScript incremental build cache
*.tsbuildinfo
next-env.d.ts

# Documentation and CI — not required in the runtime image
docs
.github
README.md
LICENSE
*.md

# Docker files themselves (avoid recursive copy noise)
Dockerfile
docker-compose*.yml
.dockerignore

# Certificates — never embed CA files from the build context
*.pem
*.crt
*.key
certs
certificates
